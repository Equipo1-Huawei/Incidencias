# Huawei Cloud MaaS Configuration
PANGU_API_KEY=
PANGU_BASE_URL=https://maas.cn-north-4.myhuaweicloud.com
HUAWEI_MODEL=pangu-40b
HUAWEI_REGION=cn-north-4

# Fallback LLM (OpenAI-compatible)
OPENAI_FALLBACK_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# MongoDB Atlas
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/triage_db?retryWrites=true&w=majority

# Endpoints
NEXTJS_HEALTH_URL=http://nextjs:3000/api/health
FASTAPI_WEBHOOK_URL=http://fastapi:8000/webhook/n8n

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333

# Guardrails
MAX_LOOPS=12
MAX_COST_USD=1.0

# App Settings
LOG_LEVEL=INFO
DEBUG=False
