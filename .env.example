# Huawei Cloud MaaS Configuration
PANGU_API_KEY=
PANGU_BASE_URL=https://maas.cn-north-4.myhuaweicloud.com
HUAWEI_MODEL=pangu-40b
HUAWEI_REGION=cn-north-4

# Fallback LLM (OpenAI-compatible)
OPENAI_FALLBACK_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Supabase (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Webhook Security
WEBHOOK_API_KEY=
RATE_LIMIT_PER_MINUTE=30

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Endpoints
NEXTJS_HEALTH_URL=http://nextjs:3000/api/health
FASTAPI_WEBHOOK_URL=http://fastapi:8000/webhook/n8n
# (n8n removed — Streamlit calls FastAPI directly)

# Agent Settings
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=1500
AGENT_TIMEOUT_SECONDS=15

# App Settings
LOG_LEVEL=INFO
DEBUG=False
